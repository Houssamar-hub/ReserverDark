# =============================================
#  ReserverDark - Server Environment Variables
# =============================================

# Server
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/reserverdark

# Auth
JWT_SECRET=change_this_to_a_long_random_secret_in_production
JWT_EXPIRE=7d

# CORS - separate multiple origins with commas
CLIENT_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# =============================================
#  Google Gemma & Gemini AI Assistant Config
# =============================================
# Google Gemma 4 via Gemini API:
GEMMA_API_KEY=your_actual_api_key
# Model identifier (e.g. gemma-4-26b-a4b-it or gemini-2.5-flash)
GEMMA_MODEL=gemma-4-26b-a4b-it
GEMMA_TIMEOUT_MS=15000

# Cloudinary (optional - leave empty to use local storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Contact info
CONTACT_EMAIL=your_email@gmail.com
CONTACT_PHONE=+212600000000
