# =============================================
#  ReserverDark - Server Environment Variables
# =============================================

# Server
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/reserverdark

# Auth
JWT_SECRET=change_this_to_a_long_random_secret_in_production
JWT_EXPIRE=7d

# CORS - separate multiple origins with commas
CLIENT_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Cloudinary (optional - leave empty to use local storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Contact info
CONTACT_EMAIL=your_email@gmail.com
CONTACT_PHONE=+212600000000
