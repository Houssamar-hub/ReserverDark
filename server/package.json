{
  "name": "server",
  "version": "1.0.0",
  "type": "module",
  "description": "ReserverDark Backend API",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node seed/seed.js",
    "db:export": "node scripts/exportSnapshot.js",
    "db:restore": "node scripts/restoreSnapshot.js",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --config jest.config.json",
